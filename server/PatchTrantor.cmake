set(socket_file "${SOURCE_DIR}/trantor/trantor/net/inner/Socket.cc")
file(READ "${socket_file}" source)
set(original "LOG_SYSERR << \", Bind address failed at \" << localaddr.toIpPort();\n        exit(1);")
set(replacement "LOG_SYSERR << \", Bind address failed at \" << localaddr.toIpPort();\n        throw std::runtime_error(\"Listener bind failed at \" + localaddr.toIpPort());")
string(FIND "${source}" "${replacement}" patched)
if(NOT patched EQUAL -1)
    return()
endif()
string(FIND "${source}" "${original}" position)
if(position EQUAL -1)
    message(FATAL_ERROR "Pinned Trantor bind-failure patch no longer matches")
endif()
string(REPLACE "${original}" "${replacement}" source "${source}")
string(REPLACE "#include <assert.h>" "#include <assert.h>\n#include <stdexcept>" source "${source}")
file(WRITE "${socket_file}" "${source}")
