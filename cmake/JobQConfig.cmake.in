@PACKAGE_INIT@

set(JobQ_VERSION "@PROJECT_VERSION@")
set(JobQ_VERSION_MAJOR @PROJECT_VERSION_MAJOR@)
set(JobQ_VERSION_MINOR @PROJECT_VERSION_MINOR@)
set(JobQ_VERSION_PATCH @PROJECT_VERSION_PATCH@)

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/JobQTargets.cmake")

if(NOT TARGET JobQ::API)
    add_library(JobQ::API ALIAS JobQ::JobQ)
endif()

check_required_components(JobQ)
